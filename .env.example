# ---------------------------------------------------------------- storage
DATABASE_URL=postgres://...

# ------------------------------------------------------------- keeper feed
KEEPER_SECRET=
ALLOW_SIM=0

# ------------------------------------------------- real money (chain 4663)
# Leave BOTH of the next two unset and the site runs exactly as before:
# positions are book entries, nothing is paid, nothing is collected.
# Setting both switches every buy to a real USDG transfer.

# Wallet that receives every stake and pays every winner.
TREASURY_ADDRESS=0x

# Signer for payouts.
#
# This key can move the entire treasury. It is read only on the server and
# is never sent to a browser, but anyone who can read the deployment's
# environment can drain the wallet, so it should belong to a wallet that
# holds float and nothing else, funded to roughly twice the largest ticket
# the book should accept. There is no recovery path for a leak of this key.
TREASURY_PRIVATE_KEY=

# Optional: a private RPC. The public endpoint is used when this is unset.
RH_RPC_URL=
